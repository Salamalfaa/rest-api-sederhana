            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "PUT multipart langsung didukung. Pilih file di field image jika ingin mengganti foto. Hapus baris image jika hanya memperbarui teks/angka. Jangan set Content-Type manual; biarkan Postman mengatur boundary."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
