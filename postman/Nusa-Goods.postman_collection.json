              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.eql(true);",
              "    pm.collectionVariables.set('lastDeletedProductId', String(pm.collectionVariables.get('productId')));",
              "});"
            ]
          }
        }
      ]
    },
