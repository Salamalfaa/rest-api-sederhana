    {
      "name": "Hapus produk aktif",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Penghapusan permanen. URL harus berakhir dengan ID, misalnya /products/1. Kosongkan tab Body; DELETE tidak memerlukan form-data. productId tetap disimpan setelah delete agar URL tidak berubah menjadi /products/."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('productId');",
              "if (!id || !/^\\d+$/.test(id)) {",
              "    console.error('Isi productId dengan ID produk yang valid. Jalankan Buat produk atau pilih ID dari Daftar produk.');",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produk berhasil dihapus', function () {",
