{
  "info": {
    "_postman_id": "d35a2dd2-217b-465e-baf8-4a56e2d03d35",
    "name": "Nusa Goods REST API",
    "description": "Koleksi untuk menguji daftar, detail, tambah, ubah, hapus, ringkasan, dan jejak aktivitas produk.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "productId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Daftar produk",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/?q=&sort=latest&per_page=9&page=1",
          "host": ["{{baseUrl}}"],
          "path": ["products", ""],
          "query": [
            { "key": "q", "value": "" },
            { "key": "sort", "value": "latest" },
            { "key": "per_page", "value": "9" },
            { "key": "page", "value": "1" }
          ]
        },
        "description": "Daftar produk sekaligus menyimpan productId pertama yang tampil jika ID aktif kosong atau sudah tidak ada. Request detail, PUT, dan DELETE koleksi memakai ID tersebut."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Daftar produk berhasil dimuat', function () {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.eql(true);",
              "    pm.expect(response.data.data).to.be.an('array');",
              "    const products = response.data.data;",
              "    const selectedId = pm.collectionVariables.get('productId');",
              "    if (products.length === 0) {",
              "        pm.collectionVariables.unset('productId');",
              "    } else if (!products.some(product => String(product.id) === selectedId)) {",
              "        pm.collectionVariables.set('productId', String(products[0].id));",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Detail produk aktif",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "url": {
          "raw": "{{baseUrl}}/products/{{productId}}",
          "host": ["{{baseUrl}}"],
          "path": ["products", "{{productId}}"]
        },
        "description": "Jalankan Buat produk agar productId terisi otomatis, atau isi variabel collection productId dengan ID yang ada. URL harus berakhir dengan ID, misalnya /products/1."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const id = pm.collectionVariables.get('productId');",
              "if (!id || !/^\\d+$/.test(id)) {",
              "    console.error('Isi productId dengan ID produk yang valid sebelum mengirim request.');",
              "    pm.execution.skipRequest();",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Detail produk ditemukan', function () {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.eql(true);",
              "    pm.expect(response.data.id).to.eql(Number(pm.collectionVariables.get('productId')));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Buat produk",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "title", "value": "Produk dari Postman", "type": "text" },
            { "key": "description", "value": "Produk contoh yang dibuat melalui koleksi Postman.", "type": "text" },
            { "key": "price", "value": "125000", "type": "text" },
            { "key": "stock", "value": "10", "type": "text" },
            { "key": "image", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": ["{{baseUrl}}"],
          "path": ["products"]
        },
        "description": "Pilih file JPG, PNG, atau WEBP maksimal 2 MB untuk field image. ID produk dari respons akan disimpan ke productId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Produk berhasil dibuat', function () {",
              "    pm.response.to.have.status(201);",
              "    const response = pm.response.json();",
              "    pm.expect(response.success).to.eql(true);",
              "    pm.expect(response.data.id).to.exist;",
              "    pm.collectionVariables.set('productId', String(response.data.id));",
              "});"
            ]
          }
        }
      ]
    },
    {
